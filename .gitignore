# ============================================================================
#  STM32H743 + STM32CubeMX + Keil MDK(uVision) 工程：car_control_motor
#  原则：源码 / CubeMX 配置(.ioc) / Keil 工程文件 / 文档 全部纳入版本管理，
#        只忽略「编译可再生成」的产物和「只与个人电脑有关」的文件。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Keil MDK 编译产物（可再生成，不提交）
#    MDK-ARM/<目标名>/ 是 Keil 的输出目录，整个目录都是产物。
# ---------------------------------------------------------------------------
MDK-ARM/car_control_motor/

# 编译/链接中间文件与输出（防止输出目录被改到别处时漏网）
*.o
*.crf
*.d
*.dep
*.lnp
*.iex
*.axf
*.htm
*.map
*.lst
*.Bak
*.bak

# 固件镜像产物。若想把 .hex/.bin 也纳入版本管理，删掉下面 3 行
# （注意：被忽略目录 MDK-ARM/car_control_motor/ 里的文件无法用 ! 反忽略，
#   需要的话请把固件另存到 release/ 之类的目录再提交）
*.hex
*.bin
*.elf

# ---------------------------------------------------------------------------
# 2. Keil / J-Link 个人环境文件（换台电脑会重新生成，且含用户名等信息）
#    保留不动的是：car_control_motor.uvprojx(工程) / .uvoptx(调试配置) /
#    EventRecorderStub.scvd / startup_stm32h743xx.s / DebugConfig/ / RTE/
# ---------------------------------------------------------------------------
*.uvguix.*
MDK-ARM/JLinkLog*.txt
MDK-ARM/JLinkSettings.ini
MDK-ARM/build_log.txt

# ---------------------------------------------------------------------------
# 3. STM32CubeMX 中间文件（.ioc 才是唯一要保存的配置源）
#    .mxproject 由 CubeMX 从 .ioc 重新生成；若要跟踪它，删掉下一行
# ---------------------------------------------------------------------------
.mxproject

# ---------------------------------------------------------------------------
# 4. 编辑器 / 操作系统 / 其它
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store

# 通用构建目录（以后若改用 CMake/Makefile 会用到）
build/
Debug/
Release/

# Python（工程里跑脚本时用，可留可删）
__pycache__/
*.pyc
